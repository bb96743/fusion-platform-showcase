# 预发布环境：只在打包时使用
#
# 说明（改造时修正）：
#  1) 已移除 `NODE_ENV=production`（原因见 .env.prod）
#  2) VITE_BASE_PATH 原为作者 CDN 的**绝对 URL**，它同时被喂给 Vite 的 base 与
#     createWebHistory()，会导致资源路径与路由基址错误。此处改为常规根路径 '/'。
#     若预发布部署在子路径，请改成 '/your-sub-path/'（**必须是路径，不能是完整 URL**）。
#  3) VITE_MALL_H5_DOMAIN 已删除（mall 模块未保留）

VITE_DEV=false

# 请求路径（空 = 同源；预发布若独立域名请填实际地址）
VITE_BASE_URL=''

# 文件上传类型：server - 后端上传， client - 前端直连上传，仅支持S3服务
VITE_UPLOAD_TYPE=server

# 接口地址
VITE_API_URL=/admin-api

# 是否删除debugger
VITE_DROP_DEBUGGER=true

# 是否删除console.log
VITE_DROP_CONSOLE=true

# 是否sourcemap
VITE_SOURCEMAP=false

# 打包路径（路径，不是 URL）
VITE_BASE_PATH=/

# 输出路径
VITE_OUT_DIR=dist-stage

# GoView 大屏域名（报表模块使用）
# ⚠️ 同理不能写 127.0.0.1；预发布请填真实地址，或留空。
VITE_GOVIEW_URL=''
