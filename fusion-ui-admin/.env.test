# 测试环境：只在打包时使用
#
# 说明（F0 修正）：
#  1) 移除 `NODE_ENV=production` —— Vite 8 构建时会自行设置 NODE_ENV，
#     写在 .env 里会触发告警（同 .env.prod）。
#  2) VITE_BASE_URL 原为 'http://localhost:48080'，测试包会去请求本机地址。改为空 = 同源。
#  3) VITE_BASE_PATH 原为 '/admin-ui-vue3/'（上游的部署子路径），已改为 '/'。
#     若测试环境确实部署在子路径，请改回实际路径。
#  4) VITE_MALL_H5_DOMAIN 已删除（mall 模块未保留）。

VITE_DEV=false

# 请求路径（空 = 同源）
VITE_BASE_URL=''

# 文件上传类型：server - 后端上传， client - 前端直连上传，仅支持S3服务
VITE_UPLOAD_TYPE=server

# 接口地址
VITE_API_URL=/admin-api

# 是否删除debugger
VITE_DROP_DEBUGGER=true

# 是否删除console.log
VITE_DROP_CONSOLE=true

# 是否sourcemap
VITE_SOURCEMAP=false

# 打包路径（路径，不是 URL）
VITE_BASE_PATH=/

# 输出路径
VITE_OUT_DIR=dist-test

# GoView 大屏域名（报表模块使用）；不能写 127.0.0.1，按测试环境填真实地址或留空
VITE_GOVIEW_URL=''