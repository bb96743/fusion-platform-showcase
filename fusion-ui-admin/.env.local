# 本地开发环境：本地启动所有项目（前端、后端、APP）时使用，不依赖外部环境
NODE_ENV=development

VITE_DEV=true

# 请求路径
VITE_BASE_URL='http://localhost:48080'

# 文件上传类型：server - 后端上传， client - 前端直连上传，仅支持 S3 服务
VITE_UPLOAD_TYPE=server

# 接口地址
VITE_API_URL=/admin-api

# 是否删除debugger
VITE_DROP_DEBUGGER=false

# 是否删除console.log
VITE_DROP_CONSOLE=false

# 是否sourcemap
VITE_SOURCEMAP=false

# 是否开启压缩，可以设置为 none, gzip, brotli, gzip,brotli
VITE_COMPRESS=none

# 打包路径
VITE_BASE_PATH=/

# 验证码的开关
VITE_APP_CAPTCHA_ENABLE=false

# ⚠️ 默认登录信息**不要**写在本文件里！
#    Vite 的加载顺序是：.env.env.local.local → .env.env.local → .env.local → .env
#    注意 `.env.local` 是**所有模式都会加载**的（不是只在 dev），
#    所以把账号密码写在这里会被 `pnpm build:prod` 一起打进生产包（实测确实漏了）。
#    本地开发的预填值请写在 `.env.env.local`（仅 `--mode env.local` 生效）。

# GoView域名
VITE_GOVIEW_URL='http://127.0.0.1:3000'
