# 生产环境：只在打包时使用
#
# 说明（改造时修正）：
#  1) 已移除 `NODE_ENV=production` —— Vite 8 在执行 build 时会自行设置 NODE_ENV，
#     写在 .env 里会触发告警 "NODE_ENV=production is not supported in the .env file"。
#  2) VITE_BASE_URL 原本指向 'http://localhost:48080'，生产包会去请求本机地址。
#     改为空串 = **同源**，适用于「nginx 把 /admin-api 反向代理到后端」的常规部署。
#     若后端在独立域名，请改成实际地址，例如 'https://api.your-domain.com'。
#  3) VITE_MALL_H5_DOMAIN 已删除 —— 商城模块（mall）在本项目中未保留。

VITE_DEV=false

# 请求路径（空 = 同源）
VITE_BASE_URL=''

# 文件上传类型：server - 后端上传， client - 前端直连上传，仅支持S3服务
VITE_UPLOAD_TYPE=server

# 接口地址
VITE_API_URL=/admin-api

# 是否删除debugger
VITE_DROP_DEBUGGER=true

# 是否删除console.log
VITE_DROP_CONSOLE=true

# 是否sourcemap
VITE_SOURCEMAP=false

# 是否开启压缩，可以设置为 none, gzip, brotli, gzip,brotli
VITE_COMPRESS=none

# 打包路径（部署在子路径时才需要改，例如 '/admin/'）
VITE_BASE_PATH=/

# 输出路径
VITE_OUT_DIR=dist-prod

# GoView 大屏域名（报表模块使用）
# ⚠️ 必须按环境填写真实地址。原先是 'http://127.0.0.1:3000'，会把**本机地址打进生产包**
#    （dist-prod 产物中已实测命中）。留空则前端显示「未配置 GoView 地址」提示，不会报错。
VITE_GOVIEW_URL=''
