# ============================================================================
#  .env.env.local.example —— 本地开发的「登录预填值」模板
#
#  用法（首次拉起本地环境时执行一次）：
#    copy fusion-ui-admin\.env.env.local.example fusion-ui-admin\.env.env.local
#    然后把口令填上（与数据库中 admin 账号的口令一致）。
#
#  ⚠️ 真正的 `.env.env.local` **不入版本库**（见根目录 .gitignore）——
#     它含管理员口令。口令用 `_tooling/14-set-admin-password.ps1` 设置，
#     设完会打印出来；本机当前口令请直接问维护者。
#
#  文件名为什么这么怪：`.env.env.local`
#    `pnpm dev` 的脚本是 `vite --mode env.local`，Vite 按下面的顺序加载：
#        .env.env.local.local  →  .env.env.local  →  .env.local  →  .env
#    其中 `.env.env.local` 只在 mode = `env.local` 时加载，
#    因此它是「只影响 dev、绝不影响 build:prod」的正确位置。
#
#  ⚠️ 千万别写进 `.env.local`：那个文件**所有模式都会加载**，
#     会把账号密码一起打进生产包（本项目实测踩过这个坑）。
#
#  ⚠️ VITE_APP_DEFAULT_LOGIN_TENANT 必须与数据库 system_tenant.name **完全一致**，
#     否则登录会报「请求的租户标识未传递」。
#     当前库中租户 id=1 的 name = `Fusion 数智业务中台`。
#
#  ⚠️ 生产 / 预发环境的 admin 口令必须是**另一个**更强的口令。
#  ⚠️ 若口令里含 `#` 或 `=`，**必须加引号**（如 `VITE_APP_DEFAULT_LOGIN_PASSWORD = "a#b=c"`），
#     否则 dotenv 会把 `#` 当注释起始、把 `=` 当键值分隔符，口令会被截断。
# ============================================================================

# 仅在启用多租户（VITE_APP_TENANT_ENABLE=true）时才需要下面这行
VITE_APP_DEFAULT_LOGIN_USERNAME = admin
VITE_APP_DEFAULT_LOGIN_PASSWORD = "TODO_填入数据库里_admin_的口令"
