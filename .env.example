# ============================================================================
#  根目录 .env 的模板（给 docker-compose 用）
#
#  用法：copy .env.example .env   然后改掉带 ⚠️ 的值。
#  ⚠️ `.env` **不入版本库**（见根目录 .gitignore）—— 它含口令。
# ============================================================================

# ---- MySQL ----
MYSQL_DATABASE=fusion
# ⚠️ 必须改：容器里 MySQL 的 root 口令
MYSQL_ROOT_PASSWORD=change-me-please
MYSQL_PORT=3306

# ---- Redis ----
REDIS_PORT=6379

# ---- 应用端口 ----
SERVER_PORT=48080
ADMIN_PORT=8080

# ---- 其它 ----
# 对外访问地址（用于支付回调等）
FUSION_SITE_URL=http://localhost:8080
# 是否启用多租户（见 需求分析文档.md 14.8 D3）
FUSION_TENANT_ENABLE=false
# 版本号，仅用于镜像 tag
FUSION_VERSION=1.0.0
# JVM 参数
JAVA_OPTS=-Xms512m -Xmx1024m -Duser.home=/app -Djava.security.egd=file:/dev/./urandom

# ---- 大模型密钥（可留空）----
# 留空也能启动；管理后台的「AI 对话」读的是数据库里的密钥配置
# （见「AI 大模型 → API 密钥」，或 fusion/sql/mysql/ai-deepseek-seed.sql）。
# ⚠️ 不要把真实密钥提交进版本库。
DEEPSEEK_API_KEY=
